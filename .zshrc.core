# Main .zshrc file
# shellcheck shell=bash

export EDITOR=vim

PROMPT='%F{blue}%~ %(?.%F{green}.%F{red})%#%f '

# RPROMPT stays empty while typing and shows the execution time once Enter is
# pressed: zle-line-finish fills it in and redraws the prompt, precmd clears it
# again before the next prompt
_rprompt_time='%F{cyan}[%D{%b %d, %Y, %H:%M}]%f'
autoload -Uz add-zsh-hook
_rprompt_clear() { RPROMPT=''; }
add-zsh-hook precmd _rprompt_clear
zle-line-finish() { RPROMPT=$_rprompt_time; zle reset-prompt; }
zle -N zle-line-finish

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
setopt share_history
setopt inc_append_history

alias g="git"

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    if [ -r ~/.dircolors ]; then
        eval "$(dircolors -b ~/.dircolors)"
    else
        eval "$(dircolors -b)"
    fi
    alias ls='ls --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
# disk usage of every entry (dotfiles included), largest first
# (D) includes dotfiles, (N) nullglob: no error when the dir has no match
alias dus='du -sh -- *(DN) 2>/dev/null | sort -hr'

# no-op "use" of variables read by zsh itself, to silence shellcheck SC2034
: "$PROMPT" "$RPROMPT" "$SAVEHIST"
